# =========================================================================
# Feishu / Lark App Credentials Configuration Template
# =========================================================================

# Complete official keys (Recommended)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternatively, short keys (also supported automatically by the refactored code)
APP_ID=cli_xxxxxxxxxxxxxx

# Agent backend for this isolated copy. Do not use the same Feishu app
# credentials as the running codex bot, or Feishu will deliver events twice.
AGENT_BACKEND=codex
CODEX_BIN=codex
# Optional: leave blank to use the Codex CLI/account default model.
CODEX_MODEL=
# Restrict the bot's project browser to this root in production.
WORKSPACE_ROOT=/home/ubuntu/projects
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
