# =========================================================================
# Feishu / Lark App Credentials
# =========================================================================

# Complete official keys (Recommended)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternatively, short keys (also supported)
# APP_ID=cli_xxxxxxxxxxxxxx
# APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================================================================
# Access control (optional but strongly recommended)
# Comma-separated open_id / chat_id values. Empty = allow all (insecure).
# =========================================================================
ALLOWED_USERS=
ALLOWED_CHATS=

# 是否跳过权限门禁（默认 true 仅限自部署单用户场景）。
# 生产/多人环境请设为 false 以启用完整的 /auth /user 权限体系。
DANGEROUSLY_SKIP_PERMISSIONS=true

# 自部署场景：允许首个群聊会话绑定管理员（上游项目仅支持私聊绑定）。
# 如需严格私聊绑定，请设为 false。
AUTH_BOOTSTRAP_ALLOW_GROUP=true

# =========================================================================
# Codex CLI engine
# =========================================================================

# Agent backend for this bot. Do not reuse the same Feishu app credentials
# across multiple running bots, or Feishu will deliver events twice.
AGENT_BACKEND=codex

# Codex binary name or absolute path. Default: codex (auto-detected in PATH)
CODEX_BIN=codex

# Default model override passed as --model. Empty = CLI/account default.
CODEX_MODEL=

# Models shown in the /model switch panel (comma-separated).
# CODEX_MODELS=gpt-5.1-codex,gpt-5.1-codex-mini,gpt-5.1,gpt-5-codex,gpt-5

# Default workspace root used by the project browser card. Default: ~
WORKSPACE_ROOT=

# =========================================================================
# Updates
# =========================================================================

# Optional git mirror used by /update when GitHub is unreachable.
# May embed credentials, e.g. https://user:token@gitee.com/user/repo.git
GIT_MIRROR_URL=

# 备选镜像（插件/OTA 热更新回退链的第二跳），GitHub 与 GIT_MIRROR_URL 均不可达时使用。
GITEE_MIRROR_URL=
